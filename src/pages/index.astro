---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactMethods from "../components/react/ContactMethods";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SocialLinks from "../components/react/SocialLinks";
import { education, experience, profile, projects, skillGroups } from "../content/portfolio";

const pageDescription = "Saurabh Dohaiya is a backend-focused software engineer, formerly at Aspora, available to join immediately.";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: "https://saurabh-dohaiya-portfolio-ujio.vercel.app",
  sameAs: profile.socials.map(({ href }) => href),
};
---

<BaseLayout description={pageDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </Fragment>

  <section class="hero page-shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker">Former Software Engineer · Aspora</p>
      <p class="eyebrow hero-availability"><span class="status-dot"></span> Immediate joiner · Open to backend roles</p>
      <h1 id="hero-title">Building <em>systems</em><br />that move work forward.</h1>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
        <a class="button button-quiet" href={profile.resume} target="_blank" rel="noreferrer">View resume <span aria-hidden="true">↗</span></a>
      </div>
      <SocialLinks links={profile.socials} className="social-links" />
    </div>
    <div class="hero-art" data-tilt-card aria-label="Portrait of Saurabh Dohaiya">
      <div class="hero-glow"></div>
      <div class="portrait-frame"><img src={profile.portrait} alt="Saurabh Dohaiya" width="400" height="400" fetchpriority="high" /></div>
      <div class="hero-orbit orbit-large"></div>
      <div class="hero-orbit orbit-small"></div>
      <div class="floating-note floating-note-backend"><span class="note-mark" aria-hidden="true">✳</span><strong>Backend</strong></div>
      <div class="floating-note floating-note-data"><span class="note-mark" aria-hidden="true">✳</span><strong>Databases &amp; APIs</strong></div>
      <div class="floating-note floating-note-platforms"><span class="note-mark" aria-hidden="true">✳</span><strong>Platforms</strong></div>
      <div class="floating-note floating-note-products"><span class="note-mark" aria-hidden="true">✳</span><strong>Products</strong></div>
    </div>
  </section>

  <section class="section section-experience" id="experience" aria-labelledby="experience-title">
    <div class="page-shell">
      <SectionHeading eyebrow="Experience · 2024—2026" title="Building across the stack." description="From frontend foundations to platform ownership and systems used across production teams." />
      <div class="experience-timeline" aria-label="Career timeline">
        <div class="experience-rail" aria-hidden="true">
          <span class="experience-progress"></span>
          <span class="experience-progress-dot"></span>
        </div>
        {experience.map((entry, index) => (
          <article class:list={["experience-entry", index % 2 === 0 ? "experience-entry-even" : "experience-entry-odd"]}>
            <div class="experience-detail">
              <p class="eyebrow experience-period">{entry.period}</p>
              <h3>{entry.role}</h3>
              <p class="experience-summary">{entry.summary}</p>
              <ul class="highlight-list">{entry.highlights.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div class="experience-brand-card">
              <img class:list={["company-logo", index === 0 ? "company-logo-aspora" : "company-logo-digio"]} src={index === 0 ? "/images/aspora-logo.jpeg" : "/images/digio-logo.png"} alt={`${entry.company} logo`} />
              <span class="experience-company-name">{entry.company}</span>
              <span class="experience-company-caption">{index === 0 ? "YC W22 · Previously Vance" : "Software solutions"}</span>
            </div>
            <span class="experience-node" aria-hidden="true">0{index + 1}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section page-shell" id="work" aria-labelledby="work-title">
    <SectionHeading eyebrow={`Selected work · 01—${String(projects.length).padStart(2, "0")}`} title="A few things I’ve built." description="Platform work and product experiences, from internal systems to full-stack products." />
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <a class="text-link section-link" href="/work/">Explore all case studies <span aria-hidden="true">↗</span></a>
  </section>

  <section class="section page-shell" id="about" aria-labelledby="about-title">
    <div class="about-grid">
      <div>
        <SectionHeading eyebrow="Toolkit · by discipline" title="Curious by default." description="I enjoy connecting product needs with dependable engineering, whether that means shaping a UI or designing the systems behind it." />
        <a class="text-link" href="/resume/">More about my background <span aria-hidden="true">↗</span></a>
      </div>
      <div class="skill-grid">
        {skillGroups.map((group) => (
          <article class="skill-group"><h3>{group.title}</h3><ul class="tag-list">{group.skills.map((skill) => <li>{skill}</li>)}</ul></article>
        ))}
      </div>
    </div>
    <div class="education-strip"><span class="eyebrow">Education</span><div><strong>{education.degree}</strong><span>{education.institution}</span></div><span>{education.result} · {education.period}</span></div>
  </section>

  <section class="contact-section page-shell" id="contact" aria-labelledby="contact-title">
    <div class="contact-panel">
      <div class="contact-orb" aria-hidden="true"></div>
      <p class="eyebrow">Have a good problem to solve?</p>
      <h2 id="contact-title">Let’s make<br /><em>something matter.</em></h2>
      <p class="contact-description">For thoughtful conversations about engineering, products, or the next interesting challenge.</p>
      <a class="button button-primary" href={`mailto:${profile.email}`}>Say hola 👋 <span aria-hidden="true">↗</span></a>
      <ContactMethods email={profile.email} phone={profile.phone} className="contact-details" />
    </div>
  </section>
</BaseLayout>
