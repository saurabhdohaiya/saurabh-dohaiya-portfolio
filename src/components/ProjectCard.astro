---
import type { ProjectEntry } from "../content/portfolio";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
---

<article class:list={["project-card", `project-${project.visual}`]}>
  <a class="project-card-link" href={`/work/${project.slug}/`} aria-label={`Read the ${project.title} case study`}>
    <div class="project-visual" aria-hidden="true">
      {project.visual === "featurelab" && (
        <div class="featurelab-visual">
          <div class="visual-orbit orbit-one"></div>
          <div class="visual-orbit orbit-two"></div>
          <div class="visual-core"><span></span><span></span><span></span></div>
          <span class="visual-caption">distributed configuration</span>
        </div>
      )}
      {project.visual === "horus" && (
        <div class="horus-visual">
          <div class="ui-window"><i></i><i></i><i></i><span class="ui-line"></span><span class="ui-block"></span><span class="ui-line short"></span></div>
          <div class="ui-window offset"><i></i><i></i><i></i><span class="ui-line"></span><span class="ui-block"></span><span class="ui-line short"></span></div>
          <span class="visual-caption">one system · many interfaces</span>
        </div>
      )}
      {project.visual === "zesty" && (
        <img src="/project-thumb-1.png" alt="" loading="lazy" width="1280" height="720" />
      )}
      {project.visual === "currency" && <div class="product-visual currency-visual"><span class="visual-caption">USD / INR · rate watch</span><div class="exchange-card"><small>Exchange rate monitor</small><strong>Live rates <span>●</span></strong><div class="exchange-chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><small class="chart-label">RATE HISTORY</small></div><div class="alert-chip">↗ Rate alert active</div></div>}
      {project.visual === "rules" && <div class="product-visual rules-visual"><span class="visual-caption">rule composition · AST</span><div class="rule-node rule-root">AND</div><div class="rule-branch"><div class="rule-node">country = IN</div><div class="rule-node">age &gt; 18</div></div></div>}
      {project.visual === "chat" && <div class="product-visual chat-visual"><span class="visual-caption">messages · in real time</span><div class="chat-window"><div class="chat-top"><i></i><span>ChatByte</span><b>•••</b></div><div class="chat-bubble">Are we still on for today?</div><div class="chat-bubble chat-bubble-out">Yes, see you soon <span>✓✓</span></div><div class="chat-input">Write a message <b>↑</b></div></div></div>}
      <span class="project-number">{project.number}</span>
    </div>
    <div class="project-copy">
      <div class="project-title-row">
        <div><p class="eyebrow">{project.kind}</p><h3>{project.title}</h3></div>
        <span class="round-arrow" aria-hidden="true">↗</span>
      </div>
      <p class="project-summary">{project.summary}</p>
      <ul class="tag-list" aria-label={`${project.title} technologies`}>
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </a>
</article>
